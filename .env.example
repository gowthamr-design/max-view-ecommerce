# Django Configuration
SECRET_KEY=django-insecure-maxview-luxury-ecom-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Database Configuration
DB_NAME=maxview_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Static and Media
STATIC_URL=/static/
MEDIA_URL=/media/

# SMTP Email Configuration (e.g. Gmail, SendGrid, Mailgun)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password
DEFAULT_FROM_EMAIL=MAX VIEW <your_email@gmail.com>
EMAIL_OTP_EXPIRY_MINUTES=10


